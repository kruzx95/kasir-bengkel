# ============================================
# Irian Motor — Environment Variables (STAGING)
# ============================================
# Lokasi di VPS: /var/www/irian-staging/.env
# ============================================

# Database MySQL/MariaDB (Staging Database)
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://irianmotor:PASSWORD_DATABASE_KUAT@localhost:3306/irian_motor_staging"

# Session Secret untuk JWT encryption
# Generate dengan: openssl rand -hex 32
SESSION_SECRET="ganti_dengan_random_secret_staging_min_32_karakter"

# Environment
NODE_ENV="production"

# Port untuk Staging (gunakan 3001 agar tidak tabrakan dengan production)
PORT=3001
