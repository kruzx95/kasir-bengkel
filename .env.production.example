# ============================================
# Irian Motor — Environment Variables (PRODUCTION)
# ============================================
# Lokasi di VPS: /var/www/irian-prod/.env
# ============================================

# Database MySQL/MariaDB (Production Database)
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://irianmotor:PASSWORD_DATABASE_KUAT@localhost:3306/irian_motor_prod"

# Session Secret untuk JWT encryption
# Generate dengan: openssl rand -hex 32
SESSION_SECRET="ganti_dengan_random_secret_production_min_32_karakter"

# Environment
NODE_ENV="production"

# Port untuk Production (3000)
PORT=3000
