# ============================================
# Irian Motor — Environment Variables Example
# ============================================
# Copy file ini menjadi .env dan isi sesuai konfigurasi Anda:
#   cp .env.example .env
# ============================================

# Database MySQL/MariaDB
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://irianmotor:password_anda@localhost:3306/irian_motor"

# Session Secret untuk JWT encryption
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti_dengan_random_string_yang_panjang_dan_kuat"

# Environment (development | production)
NODE_ENV="development"

# Port untuk aplikasi
PORT=3000