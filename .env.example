# ============================================
# IRIAN MOTOR — Konfigurasi Environment
# ============================================
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke repository!
# ============================================


# -----------------------------------------------
# DATABASE — Koneksi MySQL/MariaDB
# -----------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Contoh lokal (development):
DATABASE_URL="mysql://irianmotor:irianmotor123@127.0.0.1:3306/irian_motor?allowPublicKeyRetrieval=true&sslAccept=strict"
#
# Contoh VPS/Production (dengan SSL):
# DATABASE_URL="mysql://USER:PASSWORD@IP_VPS:3306/irian_motor?sslAccept=strict"


# -----------------------------------------------
# SESSION SECRET — Kunci enkripsi JWT login
# -----------------------------------------------
# Buat kunci acak minimal 32 karakter yang aman dengan perintah:
#   openssl rand -base64 32
# Jangan gunakan nilai default ini di production!
SESSION_SECRET="ganti-dengan-random-string-minimal-32-karakter"
