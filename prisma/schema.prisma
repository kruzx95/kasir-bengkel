generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Branch {
  id                 String               @id @default(cuid())
  code               String               @unique
  name               String
  address            String
  phone              String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  facebookPage       String?              @map("facebook_page")
  instagramHandle    String?              @map("instagram_handle")
  whatsappNumber     String?              @map("whatsapp_number")
  corporateCustomers CorporateCustomer[]
  corporatePayments  CorporatePayment[]
  customers          Customer[]
  indentOrders       IndentOrder[]
  mechanics          Mechanic[]
  restocks           Restock[]
  services           Service[]
  spareparts         Sparepart[]
  stockTransfers     StockTransfer[]
  transactions       Transaction[]
  users              User[]
  activityLogs       ActivityLog[]
  serviceMemos       ServiceMemo[]

  @@map("branches")
}

model User {
  id                       String             @id @default(cuid())
  branchId                 String?            @map("branch_id")
  name                     String
  email                    String             @unique
  passwordHash             String             @map("password_hash")
  role                     Role               @default(KASIR)
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  indentOrders             IndentOrder[]
  restocks                 Restock[]
  stockTransfers           StockTransfer[]
  transactions             Transaction[]
  serviceMemos             ServiceMemo[]
  corporatePaymentsCreated CorporatePayment[] @relation("CorporatePaymentCreatedBy")
  corporatePaymentsVoided  CorporatePayment[] @relation("CorporatePaymentVoidedBy")
  branch                   Branch?            @relation(fields: [branchId], references: [id])
  activityLogs             ActivityLog[]

  @@index([branchId], map: "users_branch_id_fkey")
  @@map("users")
}

model CorporateCustomer {
  id                  String             @id @default(cuid())
  branchId            String             @map("branch_id")
  name                String
  contactPerson       String?            @map("contact_person")
  contactPhone        String?            @map("contact_phone")
  address             String?
  taxId               String?            @map("tax_id")
  billingCycle        BillingCycle       @default(MONTHLY) @map("billing_cycle")
  isActive            Boolean            @default(true)
  hideServiceOnInvoice Boolean           @default(false) @map("hide_service_on_invoice")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  branch              Branch             @relation(fields: [branchId], references: [id])
  customers           Customer[]
  payments            CorporatePayment[]

  @@index([branchId], map: "corporate_customers_branch_id_fkey")
  @@map("corporate_customers")
}

model Customer {
  id                  String             @id @default(cuid())
  branchId            String             @map("branch_id")
  name                String
  phone               String?
  plateNumber         String?            @map("plate_number")
  vehicleType         String?            @map("vehicle_type")
  vehicleYear         String?            @map("vehicle_year")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  address             String?
  fuelType            FuelType?          @map("fuel_type")
  odometer            Int?
  vehicleBrand        String?            @map("vehicle_brand")
  vehicleColor        String?            @map("vehicle_color")
  corporateCustomerId String?            @map("corporate_customer_id")
  lastReminderSentAt  DateTime?          @map("last_reminder_sent_at")
  branch              Branch             @relation(fields: [branchId], references: [id])
  corporateCustomer   CorporateCustomer? @relation(fields: [corporateCustomerId], references: [id])
  indentOrders        IndentOrder[]
  transactions        Transaction[]

  @@index([branchId], map: "customers_branch_id_fkey")
  @@index([corporateCustomerId], map: "customers_corporate_customer_id_fkey")
  @@index([plateNumber])
  @@index([phone])
  @@index([name])
  @@map("customers")
}

model Service {
  id               String            @id @default(cuid())
  branchId         String            @map("branch_id")
  name             String
  price            Float
  category         String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branch           Branch            @relation(fields: [branchId], references: [id])
  transactionItems TransactionItem[]

  @@index([branchId], map: "services_branch_id_fkey")
  @@index([name])
  @@map("services")
}

model Sparepart {
  id                String            @id @default(cuid())
  branchId          String            @map("branch_id")
  name              String
  sku               String?
  buyPrice          Float             @default(0) @map("buy_price")
  sellPrice         Float             @map("sell_price")
  stock             Int               @default(0)
  warehouseStock    Int               @default(0) @map("warehouse_stock")
  minStock          Int               @default(0) @map("min_stock")
  minWarehouseStock Int               @default(0) @map("min_warehouse_stock")
  unit              String            @default("pcs")
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sparepartBrand    String?           @map("sparepart_brand")
  sparepartSize     String?           @map("sparepart_size")
  sparepartType     String?           @map("sparepart_type")
  etalase           String?           @map("etalase")
  indentOrderItems  IndentOrderItem[]
  restockItems      RestockItem[]
  stockTransfers    StockTransfer[]
  branch            Branch            @relation(fields: [branchId], references: [id])
  transactionItems  TransactionItem[]

  @@index([branchId], map: "spareparts_branch_id_fkey")
  @@index([sku])
  @@index([name])
  @@map("spareparts")
}

model Transaction {
  id                    String                       @id @default(cuid())
  branchId              String                       @map("branch_id")
  customerId            String?                      @map("customer_id")
  userId                String                       @map("user_id")
  mechanicId            String?                      @map("mechanic_id")
  invoiceNumber         String                       @unique @map("invoice_number")
  type                  TransactionType
  status                TransactionStatus            @default(COMPLETED)
  subtotal              Float                        @default(0)
  discount              Float                        @default(0)
  total                 Float                        @default(0)
  paidAmount            Float                        @default(0) @map("paid_amount")
  changeAmount          Float                        @default(0) @map("change_amount")
  paymentMethod         PaymentMethod                @default(CASH) @map("payment_method")
  notes                 String?
  transactionDate       DateTime                     @map("transaction_date") @db.Date
  odometer              Int?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  items                 TransactionItem[]
  payments              TransactionPayment[]
  branch                Branch                       @relation(fields: [branchId], references: [id])
  customer              Customer?                    @relation(fields: [customerId], references: [id])
  mechanic              Mechanic?                    @relation(fields: [mechanicId], references: [id])
  user                  User                         @relation(fields: [userId], references: [id])
  corporatePaymentLinks CorporatePaymentTransaction[]
  serviceMemos          ServiceMemo[]

  @@index([branchId, transactionDate])
  @@index([customerId], map: "transactions_customer_id_fkey")
  @@index([mechanicId], map: "transactions_mechanic_id_fkey")
  @@index([userId], map: "transactions_user_id_fkey")
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String      @map("transaction_id")
  itemType      ItemType    @map("item_type")
  serviceId     String?     @map("service_id")
  sparepartId   String?     @map("sparepart_id")
  itemName      String      @map("item_name")
  quantity      Int         @default(1)
  unitPrice     Float       @map("unit_price")
  buyPrice      Float?      @map("buy_price")
  subtotal      Float       @default(0)
  createdAt     DateTime    @default(now())
  service       Service?    @relation(fields: [serviceId], references: [id])
  sparepart     Sparepart?  @relation(fields: [sparepartId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([serviceId], map: "transaction_items_service_id_fkey")
  @@index([sparepartId], map: "transaction_items_sparepart_id_fkey")
  @@index([transactionId], map: "transaction_items_transaction_id_fkey")
  @@map("transaction_items")
}

model TransactionPayment {
  id            String        @id @default(cuid())
  transactionId String        @map("transaction_id")
  paymentMethod PaymentMethod @map("payment_method")
  amount        Float
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId], map: "transaction_payments_transaction_id_fkey")
  @@map("transaction_payments")
}

model Mechanic {
  id           String        @id @default(cuid())
  branchId     String        @map("branch_id")
  name         String
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branch       Branch        @relation(fields: [branchId], references: [id])
  transactions Transaction[]
  serviceMemos ServiceMemo[]

  @@index([branchId], map: "mechanics_branch_id_fkey")
  @@map("mechanics")
}

model Restock {
  id               String        @id @default(cuid())
  branchId         String        @map("branch_id")
  userId           String        @map("user_id")
  supplierName     String        @map("supplier_name")
  date             DateTime      @db.Date
  notes            String?
  total            Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  indentOrderId    String?       @map("indent_order_id")
  receiptImagePath String?       @map("receipt_image_path")
  paidAmount       Float         @default(0) @map("paid_amount")
  paymentStatus    String        @default("LUNAS") @map("payment_status")
  items            RestockItem[]
  branch           Branch        @relation(fields: [branchId], references: [id])
  indentOrder      IndentOrder?  @relation(fields: [indentOrderId], references: [id])
  user             User          @relation(fields: [userId], references: [id])

  @@index([branchId], map: "restocks_branch_id_fkey")
  @@index([indentOrderId], map: "restocks_indent_order_id_fkey")
  @@index([userId], map: "restocks_user_id_fkey")
  @@map("restocks")
}

model RestockItem {
  id          String    @id @default(cuid())
  restockId   String    @map("restock_id")
  sparepartId String    @map("sparepart_id")
  quantity    Int
  buyPrice    Float     @map("buy_price")
  subtotal    Float
  createdAt   DateTime  @default(now())
  restock     Restock   @relation(fields: [restockId], references: [id], onDelete: Cascade)
  sparepart   Sparepart @relation(fields: [sparepartId], references: [id])

  @@index([restockId], map: "restock_items_restock_id_fkey")
  @@index([sparepartId], map: "restock_items_sparepart_id_fkey")
  @@map("restock_items")
}

model IndentOrder {
  id           String            @id @default(cuid())
  branchId     String            @map("branch_id")
  userId       String            @map("user_id")
  supplierName String            @map("supplier_name")
  orderDate    DateTime          @map("order_date") @db.Date
  expectedDate DateTime?         @map("expected_date") @db.Date
  notes        String?
  status       IndentStatus      @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dpAmount     Float             @default(0) @map("dp_amount")
  customerId   String?           @map("customer_id")
  type         IndentType        @default(CUSTOMER)
  items        IndentOrderItem[]
  branch       Branch            @relation(fields: [branchId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  restocks     Restock[]

  @@index([branchId], map: "indent_orders_branch_id_fkey")
  @@index([customerId], map: "indent_orders_customer_id_fkey")
  @@index([userId], map: "indent_orders_user_id_fkey")
  @@map("indent_orders")
}

model IndentOrderItem {
  id             String      @id @default(cuid())
  indentOrderId  String      @map("indent_order_id")
  sparepartId    String      @map("sparepart_id")
  quantity       Int
  receivedQty    Int         @default(0) @map("received_qty")
  estimatedPrice Float       @default(0) @map("estimated_price")
  createdAt      DateTime    @default(now())
  indentOrder    IndentOrder @relation(fields: [indentOrderId], references: [id], onDelete: Cascade)
  sparepart      Sparepart   @relation(fields: [sparepartId], references: [id])

  @@index([indentOrderId], map: "indent_order_items_indent_order_id_fkey")
  @@index([sparepartId], map: "indent_order_items_sparepart_id_fkey")
  @@map("indent_order_items")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum Role {
  ADMIN
  KASIR
  MEKANIK
}

enum FuelType {
  GASOLINE
  DIESEL
}

enum BillingCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TransactionType {
  SERVICE
  SPAREPART
  MIXED
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
  PENDING_CORPORATE
  PENDING_PAYMENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  SPLIT
  DEBT
}

enum ItemType {
  SERVICE
  SPAREPART
}

enum IndentStatus {
  PENDING
  PARTIAL
  RECEIVED
}

enum IndentType {
  RESTOCK
  CUSTOMER
}

model StockTransfer {
  id           String            @id @default(cuid())
  branchId     String            @map("branch_id")
  userId       String            @map("user_id")
  sparepartId  String            @map("sparepart_id")
  type         StockTransferType
  quantity     Int
  notes        String?
  transferDate DateTime          @default(now()) @map("transfer_date")
  createdAt    DateTime          @default(now()) @map("created_at")
  branch       Branch            @relation(fields: [branchId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  sparepart    Sparepart         @relation(fields: [sparepartId], references: [id])

  @@index([branchId], map: "stock_transfers_branch_id_fkey")
  @@index([userId], map: "stock_transfers_user_id_fkey")
  @@index([sparepartId], map: "stock_transfers_sparepart_id_fkey")
  @@index([transferDate])
  @@map("stock_transfers")
}

enum StockTransferType {
  WAREHOUSE_TO_STORE
  STORE_TO_WAREHOUSE
}

// ============================================
// CORPORATE PAYMENT (Phase 5)
// Pembayaran piutang korporat (lunas / cicil)
// ============================================

model CorporatePayment {
  id                  String                       @id @default(cuid())
  corporateCustomerId String                       @map("corporate_customer_id")
  branchId            String                       @map("branch_id")
  amount              Float
  paymentMethod       PaymentMethod                @map("payment_method")
  notes               String?
  paidAt              DateTime                     @default(now()) @map("paid_at")
  createdById         String                       @map("created_by_id")
  periodStart         DateTime                     @map("period_start") @db.Date
  periodEnd           DateTime                     @map("period_end") @db.Date
  voidedAt            DateTime?                    @map("voided_at")
  voidedById          String?                      @map("voided_by_id")
  voidReason          String?                      @map("void_reason")
  createdAt           DateTime                     @default(now())

  corporateCustomer   CorporateCustomer            @relation(fields: [corporateCustomerId], references: [id])
  branch              Branch                       @relation(fields: [branchId], references: [id])
  createdBy           User                         @relation("CorporatePaymentCreatedBy", fields: [createdById], references: [id])
  voidedBy            User?                        @relation("CorporatePaymentVoidedBy", fields: [voidedById], references: [id])
  transactionLinks    CorporatePaymentTransaction[]

  @@index([corporateCustomerId], map: "corporate_payments_corporate_customer_id_fkey")
  @@index([branchId], map: "corporate_payments_branch_id_fkey")
  @@index([paidAt])
  @@map("corporate_payments")
}

model CorporatePaymentTransaction {
  id            String          @id @default(cuid())
  paymentId     String          @map("payment_id")
  transactionId String          @map("transaction_id")
  amount        Float

  payment       CorporatePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction   Transaction      @relation(fields: [transactionId], references: [id])

  @@unique([paymentId, transactionId])
  @@index([transactionId], map: "corporate_payment_transactions_transaction_id_fkey")
  @@map("corporate_payment_transactions")
}

// ============================================
// ACTIVITY / AUDIT LOG (Phase 6)
// Log Aktivitas Pengguna & Sistem untuk Admin
// ============================================

model ActivityLog {
  id          String   @id @default(cuid())
  branchId    String?  @map("branch_id")
  userId      String?  @map("user_id")
  userName    String   @map("user_name")
  userRole    Role     @map("user_role")
  action      String
  category    String
  level       String   @default("INFO")
  description String   @db.Text
  details     String?  @db.Text
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([userId])
  @@index([category])
  @@index([level])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================
// SERVICE ADVISOR / MEMO SERVIS (Point 11)
// Alur Kerja SA/Kepala Mekanik, Kasir & Pengerjaan
// ============================================

enum MemoStatus {
  DRAFT
  ESTIMATED
  IN_PROGRESS
  COMPLETED
  CONVERTED
  CANCELLED
}

model ServiceMemo {
  id                 String              @id @default(cuid())
  memoNumber         String              @unique @map("memo_number")
  queueNumber        String?             @map("queue_number")
  branchId           String              @map("branch_id")
  userId             String              @map("user_id")
  mechanicId         String?             @map("mechanic_id")
  transactionId      String?             @map("transaction_id")
  
  // Data Pelanggan & Kendaraan
  customerName       String              @map("customer_name")
  customerPhone      String?             @map("customer_phone")
  customerAddress    String?             @map("customer_address")
  vehiclePlate       String              @map("vehicle_plate")
  vehicleModel       String?             @map("vehicle_model")
  odometer           Int?                @map("odometer")
  
  // Diagnosa & Keluhan
  complaints         String?             @db.Text
  initialDiagnosis   String?             @map("initial_diagnosis") @db.Text
  estimatedDuration  String?             @map("estimated_duration")
  notes              String?             @db.Text
  status             MemoStatus          @default(DRAFT)

  // Checklist Komponen (Tune Up, Rem, Kaki-Kaki)
  checklistTuneUp    Json?               @map("checklist_tune_up")
  checklistBrakes    Json?               @map("checklist_brakes")
  checklistSuspension Json?              @map("checklist_suspension")

  // Items
  services           MemoServiceItem[]
  spareparts         MemoSparepartItem[]

  // Relations
  branch             Branch              @relation(fields: [branchId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  mechanic           Mechanic?           @relation(fields: [mechanicId], references: [id])
  transaction        Transaction?        @relation(fields: [transactionId], references: [id])

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([userId])
  @@index([mechanicId])
  @@index([status])
  @@index([vehiclePlate])
  @@index([createdAt])
  @@map("service_memos")
}

model MemoServiceItem {
  id             String      @id @default(cuid())
  memoId         String      @map("memo_id")
  serviceId      String?     @map("service_id")
  name           String
  estimatedPrice Float       @default(0) @map("estimated_price")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")

  memo           ServiceMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
  @@map("memo_service_items")
}

model MemoSparepartItem {
  id             String      @id @default(cuid())
  memoId         String      @map("memo_id")
  sparepartId    String?     @map("sparepart_id")
  name           String
  quantity       Int         @default(1)
  unit           String      @default("pcs")
  estimatedPrice Float       @default(0) @map("estimated_price")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")

  memo           ServiceMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
  @@map("memo_sparepart_items")
}


